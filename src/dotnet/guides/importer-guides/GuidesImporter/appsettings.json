{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Ingestion": {
    "DumpPath": "",
    "Regions": [],
    "ArticleLimit": 5000,
    "MinChunkTokens": 300,
    "MaxChunkTokens": 500,
    "OverlapTokens": 50,
    "MinArticleTokens": 50,
    "BatchSize": 100,
    "ProgressLogInterval": 500,
    "SourceBaseUrl": "https://en.wikivoyage.org/wiki/"
  },
  "Embeddings": {
    "BaseUrl": "http://localhost:11434/v1/",
    "Model": "nomic-embed-text",
    "Dimensions": 768,
    "SendDimensions": false,
    "DocumentPrefix": "search_document: ",
    "QueryPrefix": "search_query: ",
    "BatchSize": 64,
    "CostPerMillionTokens": 0,
    "AttemptTimeoutSeconds": 120,
    "TotalTimeoutSeconds": 600,
    "MaxRetries": 4,
    "RetryBaseDelay": "00:00:02",
    "CircuitBreakSeconds": 30
  },
  "EmbedChunks": {
    "MaxChunks": 0,
    "ProgressLogInterval": 25
  },
  "Chat": {
    "BaseUrl": "http://localhost:11434/v1/",
    "Model": "qwen2.5:3b",
    "ContextWindowTokens": 4096,
    "MaxOutputTokens": 120,
    "Temperature": 0,
    "AttemptTimeoutSeconds": 300,
    "TotalTimeoutSeconds": 700,
    "MaxRetries": 1
  },
  "Eval": {
    "QuestionsPath": "eval/questions.json",
    "SearchServiceBaseUrl": "http://localhost:5099/",
    "SearchPath": "api/search",
    "AskPath": "api/ask",
    "Modes": ["hybrid", "vector", "keyword"],
    "MaxK": 10,
    "EvaluateAnswers": true,
    "RunLabel": "baseline",
    "ReportPath": "docs/EVALUATION.md",
    "ResultsDirectory": "eval/results",
    "JudgementsToVerifyPath": "eval/judgements-to-verify.json",
    "JudgementsToVerify": 30,
    "RequestTimeoutSeconds": 900
  }
}
