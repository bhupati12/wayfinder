    "DailyCostCapUsd": 5,
    "DailyTokenCap": 2000000
  },
  "Auth": {
    "ApiKeys": []
  },
  "RateLimiting": {
    "AskPermitsPerMinute": 10,
    "SearchPermitsPerMinute": 300
  },
  "RequestTimeouts": {
    "SearchSeconds": 15,
    "AskSeconds": 300
  },
  "Sentry": {
    "Dsn": "",
    "SendDefaultPii": false,
    "TracesSampleRate": 0
  }
