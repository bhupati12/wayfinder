{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Microsoft.EntityFrameworkCore": "Warning",
      "System.Net.Http.HttpClient": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Embeddings": {
    "BaseUrl": "http://localhost:11434/v1/",
    "Model": "nomic-embed-text",
    "Dimensions": 768,
    "DocumentPrefix": "search_document: ",
    "QueryPrefix": "search_query: ",
    "BatchSize": 64,
    "AttemptTimeoutSeconds": 10,
    "TotalTimeoutSeconds": 20,
    "MaxRetries": 1,
    "RetryBaseDelay": "00:00:00.200",
    "CircuitBreakSeconds": 15
  },
  "Search": {
    "DefaultK": 10,
    "MaxK": 50,
    "MinQueryLength": 2,
    "MaxQueryLength": 500,
    "HybridCandidatePool": 50,
    "RrfK": 60,
    "TitleMatchBoost": 0.5,
    "HnswEfSearch": 100
  }
}
