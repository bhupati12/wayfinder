    "BatchSize": 64,
    "AttemptTimeoutSeconds": 10,
    "TotalTimeoutSeconds": 20,
    "MaxRetries": 1,
    "RetryBaseDelay": "00:00:00.200",
    "CircuitBreakSeconds": 15
  },
  "Search": {
    "DefaultK": 10,
    "MaxK": 50,
    "MinQueryLength": 2,
    "MaxQueryLength": 500,
    "HybridCandidatePool": 50,
    "RrfK": 60,
    "KeywordWeight": 1.0,
    "KeywordAllWordsMinResults": 10,
    "TitleMatchBoost": 0.5,
    "HnswEfSearch": 100
  },
  "Chat": {
    "BaseUrl": "http://localhost:11434/v1/",
    "Model": "qwen2.5:3b",
    "ContextWindowTokens": 4096,
    "MaxOutputTokens": 400,
    "Temperature": 0.1,
    "CostPerMillionInputTokens": 0,
    "CostPerMillionOutputTokens": 0,
    "AttemptTimeoutSeconds": 180,
    "TotalTimeoutSeconds": 400,
    "MaxRetries": 1,
    "RetryBaseDelay": "00:00:02",
    "CircuitBreakSeconds": 30
  },
